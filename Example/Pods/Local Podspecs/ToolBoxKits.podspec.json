{
  "name": "ToolBoxKits",
  "version": "1.0.0",
  "summary": "A lightweight Swift toolbox for common extensions and utilities in iOS development.",
  "description": "toolBox provides a collection of Swift extensions and helper utilities to simplify iOS development,\nincluding UIKit helpers, string processing, async utilities, and layout helpers.",
  "homepage": "http://app-gitlab.devops.guchele.cn/ios/outsource/ToolBoxKits",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "kanney": "thisiskache@gmail.com"
  },
  "source": {
    "git": "git@app-gitlab.devops.guchele.cn:ios/outsource/ToolBoxKits.git",
    "tag": "1.0.0"
  },
  "platforms": {
    "ios": "15.0"
  },
  "swift_versions": "5.0",
  "default_subspecs": [
    "Core",
    "LoadingHUD"
  ],
  "subspecs": [
    {
      "name": "Core",
      "source_files": "ToolBoxKits/Classes/**/*",
      "exclude_files": "ToolBoxKits/Classes/Loading/**/*",
      "dependencies": {
        "KingfisherWebP": [],
        "SwiftMessages": []
      }
    },
    {
      "name": "LoadingHUD",
      "source_files": "ToolBoxKits/Classes/Loading/*.swift",
      "frameworks": "UIKit"
    }
  ],
  "swift_version": "5.0"
}
